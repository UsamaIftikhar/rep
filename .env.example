# ===================================================
# REP 1 Platform Environment Configuration Template
# Copy this file to .env and fill in the values.
# NEVER commit real credentials or secrets to git.
# ===================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/rep1_db?schema=public"

# Auth / JWT Security
JWT_SECRET="your_production_secure_jwt_secret_32_characters_min"
NEXTAUTH_URL="https://www.rep1exposure.com"

# OpenAI API Key (AI Interview scoring)
OPENAI_API_KEY=""

# Stripe Payment & Billing
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ATHLETE=""
STRIPE_PRICE_ELITE_PACIFIC=""
STRIPE_PRICE_RECRUITER=""
STRIPE_PRICE_COURSE=""

# Email Notifications (SMTP / Resend)
NOTIFICATION_EMAIL=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
RESEND_API_KEY=""
RESEND_FROM=""

# Miro Integration (Interactive Whiteboard)
MIRO_CLIENT_ID=""
MIRO_CLIENT_SECRET=""
MIRO_REDIRECT_URI="https://www.rep1exposure.com/api/integrations/miro/callback"

# Zoom Integration — REST API & Webhooks
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_REDIRECT_URI="https://www.rep1exposure.com/api/integrations/zoom/callback"
ZOOM_WEBHOOK_SECRET=""
ZOOM_DELETE_AFTER_UPLOAD="false"

# Zoom Meeting SDK (General App with Meeting SDK enabled under Features -> Embed)
# ZOOM_SDK_KEY: Contains the Zoom General App Client ID
# ZOOM_SDK_SECRET: Contains the Zoom General App Client Secret
ZOOM_SDK_KEY=""
ZOOM_SDK_SECRET=""

# DigitalOcean Spaces / S3 Storage
SPACES_KEY=""
SPACES_SECRET=""
SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"
SPACES_BUCKET="rep1"
SPACES_REGION="nyc3"
SPACES_PUBLIC_URL=""
